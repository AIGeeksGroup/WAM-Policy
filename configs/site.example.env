# Site configuration for WAM-Policy. Copy to configs/site.env, edit, then `source configs/site.env`.
# Every account name, repository id and local path used by the code comes from here or from CLI flags.

# --- Released weights (Hugging Face model repository) ---
export WAM_HF_MODEL_REPO=AIGeeksGroup/WAM-Policy
export WAM_HF_MODEL_REVISION=main

# --- Upstream LingBot-VA base (VAE / T5 / 30D transformer) ---
export WAM_BASE_MODEL_REPO=robbyant/lingbot-va-base
export WAM_BASE_MODEL_REVISION=68b7bc1b35da6ddc67ea94c4ceb58d768fbb3f9c

# --- QLM-Bench dataset (also read by QLM-Bench itself) ---
export QLM_DATASET_REPO=AIGeeksGroup/QLM-Bench
export QLM_DATASET_REVISION=main

# --- Local paths (examples) ---
export WAM_ROOT=$HOME/wam-policy-data              # downloads, caches and run outputs
export WAM_BASE_MODEL=$WAM_ROOT/lingbot-va-base    # snapshot with vae/ text_encoder/ tokenizer/ transformer/
export WAM_WEIGHTS=$WAM_ROOT/weights               # snapshot of $WAM_HF_MODEL_REPO@$WAM_HF_MODEL_REVISION
export WAM_PROMPTS=$WAM_WEIGHTS/prompt_embeddings  # <task>/embedding.pt
export QLM_BENCH_SRC=$HOME/QLM-Bench/src           # src/ of the QLM-Bench checkout (Task RL reads its inputs/)
export QLM_PYTHON=$HOME/envs/qlm/bin/python        # Python of the QLM-Bench (MuJoCo) environment
export QLM_RESOURCES=$WAM_ROOT/qlm-standard100     # `python -m qlm_bench.benchmark fetch --output ...`
export QLM_BENCH_SNAPSHOT=$WAM_ROOT/qlm-bench-data  # snapshot of $QLM_DATASET_REPO (demonstrations, reset pools)
export QLM_TRAIN_POOL=$QLM_BENCH_SNAPSHOT/reset_pools/train800-reset-pool/manifest.json   # scripts/download.sh reset_pool
export QLM_OSMESA_LIB=                             # optional: directory with libOSMesa.so if not system-wide
export RAMBO_CONTROLLER=                           # optional: model_2000.pt overriding the Task RL inputs' controller

# --- Stage inputs/outputs. Inputs default to the RELEASED weights; to chain your own runs, point them at
# your outputs (README: end of each stage section). ---
export SFT_TRANSFORMER=$WAM_ROOT/stage1_1/native9-transformer   # Stage 1.1: converted 9D base
export SFT_CACHE=$WAM_ROOT/stage1_1/frozen-cache                # Stage 1.1: frozen VAE/T5 cache
export WAM_TEACHER=$WAM_WEIGHTS/stage1_1_teacher                 # teacher used by Stages 1.2/2.1/2.2
export OPSD_TEACHER_CACHE=$WAM_ROOT/runs/opsd-teacher-cache/learner/cache
export OPSD_STUDENT=$WAM_WEIGHTS/stage1_2_opsd_student           # M-OPD initial student
export MOPD_PUSH_BOX_SPECIALIST=$WAM_WEIGHTS/stage2_1_specialists/push_box
export MOPD_OPEN_ROOM_DOOR_SPECIALIST=$WAM_WEIGHTS/stage2_1_specialists/open_room_door
export MOPD_TEACHER_CACHE=$WAM_ROOT/runs/mopd-teacher-cache/cache
# Proprioception ablation
export WAM_PROPRIO_RESOURCES=$WAM_ROOT/proprioception
export WAM_PROPRIO_OUTPUT=$WAM_ROOT/runs/proprioception

# --- Optional experiment tracking (disabled by default) ---
export WANDB_MODE=disabled                         # online | offline | disabled
export WANDB_ENTITY=
export WANDB_PROJECT=wam-policy

# --- Optional upload of newly trained checkpoints (empty = no upload) ---
export WAM_UPLOAD_REPO=
