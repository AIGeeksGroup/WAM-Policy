# Standard100, default (not accelerated): one policy service + one QLM-Bench client per policy seed,
# episode by episode; the VAE runs on the CPU so a 16 GB GPU holds the 5B transformer (paper setting).
SEEDS=42,43,44          # 42 = Standard100; 43/44 = repeats of the 300-episode protocol
VAE_DEVICE=cpu
OFFLOAD_BLOCKS=0        # raise (e.g. 16) if the GPU has less than 16 GB
PORT=8862
