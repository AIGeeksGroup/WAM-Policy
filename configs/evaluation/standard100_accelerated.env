# Standard100, accelerated: one resident multi-session service (VAE on the GPU) and several concurrent
# QLM-Bench clients, one per (case, seed). Teacher/specialist use row-batched sampling across sessions;
# students use one resident model shared by concurrent sessions. Outcomes match the default path up to
# bf16 rounding of batched matrix products. Paper: 8 clients on an RTX 5090.
SEEDS=42,43,44
CLIENTS=8
MAX_BATCH=8
MAX_WAIT_S=6
PORT=8870
