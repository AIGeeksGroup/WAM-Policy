{
  "_comment": "Ablation 'Longer training': the OPSD setting (eta = 0.5) run for 900 updates (the paper run; S300 and S900 EMA students are compared). The run takes about 26 h on the paper hardware, so the worker wall-time budget is 48 h.",
  "seed": 42,
  "world_size": 8,
  "chunks_per_clip": 3,
  "student_updates": 900,
  "video_steps": 1,
  "action_steps": 2,
  "window_units": 8,
  "lora_rank": 256,
  "lora_alpha": 256,
  "learning_rate": 3e-05,
  "weight_decay": 0.01,
  "grad_clip": 1.0,
  "lr_warmup_steps": 20,
  "ema_decay": 0.99,
  "ema_start_step": 50,
  "teacher_video_steps": 25,
  "teacher_action_steps": 50,
  "huber_c": 0.001,
  "action_loss_weight": 1.0,
  "action_valid_dims": 6,
  "data_mode": "streaming",
  "offline_contexts_per_rank": 3,
  "heldout_contexts": 64,
  "heldout_every": 50,
  "checkpoint_every": 100,
  "protected_checkpoints": [
    300,
    500,
    900
  ],
  "history_reuse": true,
  "render_mode": "full",
  "worker_wall_timeout_s": 172800.0,
  "resources": {
    "teacher": "${WAM_TEACHER}",
    "base_model": "${WAM_BASE_MODEL}",
    "prompt_root": "${WAM_PROMPTS}",
    "train_pool": "${QLM_TRAIN_POOL}",
    "qlm_python": "${QLM_PYTHON}",
    "offline_cache": "${OPSD_TEACHER_CACHE}"
  }
}
