# External source repositories
/external/*

# Local datasets and processed data
/datasets/*

# Experiments, checkpoints, pretrained models, and run outputs
/experiments/*

# Evaluation outputs
/results/*

# Logs, caches, and local trackers
/logs/*
/cache/*
/wandb/*
/slurm-*.out
/slurm-*.err

