__pycache__/
*.py[cod]
*$py.class
*.so

# Python packaging/build outputs
build/
dist/
*.egg-info/
.eggs/

# Test/type-check cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local env files
.env
.venv/
venv/
ENV/

# IDE / OS files
.DS_Store
.idea/
.vscode/

# Notebook checkpoints
.ipynb_checkpoints/
