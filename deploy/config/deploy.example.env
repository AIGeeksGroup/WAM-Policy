# Robot-side configuration of deploy/. Copy to deploy/config/deploy.env and edit:
#   cp config/deploy.example.env config/deploy.env
# The model paths (WAM_TEACHER, OPSD_STUDENT, WAM_WEIGHTS, WAM_BASE_MODEL, WAM_PROMPTS, QLM_BENCH_SRC)
# and the RAMBO controller checkpoint (RAMBO_CONTROLLER) come from the repository's configs/site.env. A variable that is already
# set in the environment wins over the value below.

# --- Network: the laptop talks to the robot over Ethernet only ---
export DEMO_NIC="${DEMO_NIC:-}"                # REQUIRED: wired interface to the robot (see `ip -br link`)
export DEMO_ROBOT_IP="${DEMO_ROBOT_IP:-}"      # REQUIRED: the Go2's Ethernet address (Unitree's documentation)
export DEMO_LAPTOP_IP="${DEMO_LAPTOP_IP:-}"    # REQUIRED: a free static address for DEMO_NIC in the robot's /24
export X5_IP="${X5_IP:-}"                      # the RDK X5 camera host on the same /24 (scripts/x5/)

# --- Laptop software (README: Installation) ---
export DEPLOY_VENV="${DEPLOY_VENV:-$HOME/venvs/wam-go2}"              # Python 3.12 venv (system site packages) + requirements.txt
export UNITREE_MSGS_WS="${UNITREE_MSGS_WS:-$HOME/ros2_ws/unitree_msgs}"  # unitree_go / unitree_api (scripts/install_unitree_msgs.sh)
export DEPLOY_WS="${DEPLOY_WS:-$HOME/ros2_ws/wam_go2}"                # colcon workspace this package is built into (scripts/build.sh)
export WAM_POLICY_PYTHON="${WAM_POLICY_PYTHON:-python3}"              # Python of the WAM-Policy model environment

# --- Policy server ---
export WAM_POLICY="${WAM_POLICY:-opsd_student}"   # --policy of wam_policy.inference.serve: opsd_student | mopd_student | teacher | specialist
export WAM_PORT="${WAM_PORT:-8862}"               # local port of the policy server (127.0.0.1)
# Extra arguments for `python -m wam_policy.inference.serve`, e.g. "--vae-device cpu --offload-blocks 8"
# on a GPU with less memory.
export WAM_SERVER_ARGS="${WAM_SERVER_ARGS:-}"
