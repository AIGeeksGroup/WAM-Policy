<?xml version="1.0" encoding="UTF-8" ?>
<!-- FastDDS profile for the RDK X5 camera host (RDK X5 + D435i on the robot's
     switch). Binds the X5's DDS participant to its own wired address so
     no WiFi path is ever announced. Install on the X5 as
     ~/go2_camera_deploy/config/fastdds_x5_wired.xml and export
     FASTRTPS_DEFAULT_PROFILES_FILE to it in every ROS terminal / service.
     go2_camera.sh writes this file itself with the X5's own address in place of @X5_IP@. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_x5_wired</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>@X5_IP@</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="x5_wired_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_x5_wired</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
