{
  "description": "Collected once: the initial student collects 209 rounds x 24 = 5,016 contexts once (about the size of the teacher cache); 300 updates then regress 48 contexts per update drawn from this fixed set. Paper: S300 EMA.",
  "method": {
    "objective": "regression",
    "state_steps": 1,
    "action_steps": 2,
    "teacher_video_steps": 20,
    "teacher_action_steps": 50,
    "lora_rank": 256,
    "lora_alpha": 256,
    "lora_dropout": 0.0,
    "onpolicy_contexts_per_rank": 3,
    "offline_contexts_per_rank": 0,
    "collect_once_rounds": 209,
    "replay_contexts_per_rank": 6,
    "data_mode": "collect_once",
    "student_updates": 300,
    "world_size": 8,
    "student_lr": 3e-05,
    "weight_decay": 0.01,
    "grad_clip": 1.0,
    "huber_c": 0.001,
    "action_loss_weight": 1.0
  },
  "experiment": {
    "seed": 42,
    "adam_betas": [
      0.9,
      0.999
    ],
    "adam_epsilon": 1e-08,
    "student_lr_warmup_steps": 20,
    "ema_decay": 0.99,
    "ema_start_update": 50,
    "checkpoint_every": 100,
    "retain_checkpoints": 2,
    "protected_checkpoints": [],
    "student_snapshots": [
      100,
      200,
      300
    ],
    "heldout_contexts": 64,
    "heldout_every": 50
  }
}
