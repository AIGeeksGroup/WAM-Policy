{
  "description": "Longer training: OPSD for 900 updates (supplementary table 'Success rate (%) on LIBERO after longer training': S900 EMA). Its S300 snapshot is the OPSD student of configs/students/opsd.json.",
  "method": {
    "objective": "regression",
    "state_steps": 1,
    "action_steps": 2,
    "teacher_video_steps": 20,
    "teacher_action_steps": 50,
    "lora_rank": 256,
    "lora_alpha": 256,
    "lora_dropout": 0.0,
    "onpolicy_contexts_per_rank": 3,
    "offline_contexts_per_rank": 3,
    "collect_once_rounds": 100,
    "replay_contexts_per_rank": 0,
    "data_mode": "streaming",
    "student_updates": 900,
    "world_size": 8,
    "student_lr": 3e-05,
    "weight_decay": 0.01,
    "grad_clip": 1.0,
    "huber_c": 0.001,
    "action_loss_weight": 1.0
  },
  "experiment": {
    "seed": 42,
    "adam_betas": [
      0.9,
      0.999
    ],
    "adam_epsilon": 1e-08,
    "student_lr_warmup_steps": 20,
    "ema_decay": 0.99,
    "ema_start_update": 50,
    "checkpoint_every": 100,
    "retain_checkpoints": 2,
    "protected_checkpoints": [
      300,
      500
    ],
    "student_snapshots": [
      100,
      200,
      300,
      400,
      500,
      600,
      700,
      800,
      900
    ],
    "heldout_contexts": 64,
    "heldout_every": 50
  }
}
