  "experiment": {
    "seed": 42,
    "adam_betas": [
      0.9,
      0.999
    ],
    "adam_epsilon": 1e-08,
    "student_lr_warmup_steps": 20,
    "ema_decay": 0.99,
    "ema_start_update": 50,
    "checkpoint_every": 100,
    "retain_checkpoints": 2,
    "protected_checkpoints": [
      300
    ],
    "student_snapshots": [
      100,
      200,
      300,
      400,
      500,
      600,
      700,
      800,
      900,
      1000,
      1100,
      1200,
      1300,
      1400,
      1500,
      1600,
      1700,
      1800,
      1900,
      2000
    ],
    "heldout_contexts": 64,
    "heldout_every": 50
  }
